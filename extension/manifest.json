{
    "manifest_version": 3,
    "name": "PDFkoi - PDF Tools",
    "version": "1.0.0",
    "description": "Quick access to PDF tools for merging, splitting, compressing, and converting PDFs in your browser.",
    "author": "PDFkoi Team",
    "homepage_url": "https://PDFkoi.gitu.net",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_title": "PDFkoi - PDF Tools"
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "contextMenus"
    ]
}
